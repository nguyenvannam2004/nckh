# 1. Chọn base image là Python phiên bản 3.9
FROM python:3.9-slim

# 2. Tạo thư mục làm việc trong container
WORKDIR /app

# 3. Sao chép file requirements.txt vào container
COPY requirements.txt .

# 4. Cài đặt các thư viện từ requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 5. Sao chép toàn bộ mã nguồn vào container
COPY . .

# 6. Mở cổng mà ứng dụng sẽ chạy (Flask chạy trên cổng 5000)
EXPOSE 5000

# 7. Chạy ứng dụng (ở đây sử dụng Flask với file app.py)
CMD ["streamlit", "run", "app.py"]
